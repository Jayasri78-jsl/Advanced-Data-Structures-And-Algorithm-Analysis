#include&lt;limits.h&gt;
#define MAX 100
#define INF INT_MAX
int n,m,graph[MAX][MAX];
int minDistance(int dist[],int visited[]){int min=INF,min_index=-1;
	for(int v=0;v&lt;n;v++){if(!visited[v] &amp;&amp; dist[v]&lt;=min){
			min=dist[v];min_index=v;}}return min_index;}
void dijkstar(int src){
	int dist[MAX],visited[MAX];
	for(int i=0;i&lt;n;i++){dist[i]=INF;visited[i]=0;}dist[src]=0;
	for(int count=0;count&lt;n-1;count++){
		int u=minDistance(dist,visited);
		if(u==-1) break;visited[u]=1;
		for(int v=0;v&lt;n;v++){
			if(!visited[v]&amp;&amp; graph[u][v]!=INF &amp;&amp; dist[u]!=INF &amp;&amp; dist[u]+graph[u][v]&lt;dist[v]){
				dist[v]=dist[u]+graph[u][v];}}}
	for(int i=0;i&lt;n;i++){
		if(dist[i]==INF) printf("%d-1\n",i);
		else printf("%d %d\n",i,dist[i]);}}
int main(){
	scanf("%d %d",&amp;n,&amp;m);
	for(int i=0;i&lt;n;i++)
		for(int j=0;j&lt;n;j++)
			graph[i][j]=INF;
			for(int i=0;i&lt;m;i++){int u,v,w;scanf("%d %d %d",&amp;u,&amp;v,&amp;w);
				graph[u][v]=w;}int src;
			scanf("%d",&amp;src);dijkstar(src);return 0;}</pre><br data-ref="9c2d1019-d950-4bb4-b4af-885da31c09d2"></div></div><div class="row" data-ref="c975413d-f9c6-40ad-bed1-c8b9ef1d7839"><div class="col-12" data-ref="9d424c73-4810-43f3-968d-08bee3056152"><h5 class="execResultsHeading text-center" data-ref="081f25f3-64c2-4c17-bc99-9cbafd05fa9e">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="58b47316-9f07-4416-b7de-e890e6cca194" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="4dc73ae4-8c29-4b52-ba0d-3f12e8246893"><div class="row execution-results-border" data-ref="c6240f86-f3d7-4ab7-bdaf-b5db81787267"><div class="col-12 p-2 text-center font-weight-bold" data-ref="32d2f63c-0850-4f81-8caa-b715b9f76cbe">Test Case - 1</div></div><div class="row execution-results-border" data-ref="7882a86d-0980-4047-a717-12d0ff62df69"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="91eb6585-f629-4dff-a423-5834a8b33006">User Output</div></div><div class="row execution-results-border" data-ref="975e3c60-5584-4692-a2d7-0bc8630aa0b7"><div class="col-6" data-ref="5351e6be-7bd2-4610-a7d9-7bf7fabfbc15"><span class="cmd" title="User Input" data-ref="86400519-f7e1-43dd-a20b-c02744a7fec2">4 3</span></div></div><div class="row execution-results-border" data-ref="2344591c-c9d7-4396-9d11-98ca4cb415ae"><div class="col-6" data-ref="37ace54f-8df0-45ba-98ef-4b7d41ae82aa"><span class="cmd" title="User Input" data-ref="7bb446fd-c1e3-417c-8fa1-c1b7acab9bfb">0 1 2</span></div></div><div class="row execution-results-border" data-ref="b6ed79bb-9e79-4a7a-b683-21ae2339d0a1"><div class="col-6" data-ref="8a861e72-64be-450d-b186-6c9ecce5a3b9"><span class="cmd" title="User Input" data-ref="160af9eb-d1e4-4669-a11f-f8f58ab35259">0 2 5</span></div></div><div class="row execution-results-border" data-ref="786a2ab2-a9e9-480d-a40c-89ab9bca0558"><div class="col-6" data-ref="0d9e5262-f2a0-4363-932a-259a8