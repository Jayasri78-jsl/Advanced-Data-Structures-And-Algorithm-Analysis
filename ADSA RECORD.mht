#include&lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX];
int adjCount[MAX];
int visited[MAX];
int queue[MAX];
int front=0;int rear=0;
int compare(const void*a,const void*b){
	return (*(int*)a-*(int*)b);}
void enqueue(int v){
	queue[rear++]=v;}
int dequeue(){
	return queue[front++];}
int isEmpty(){
	return front==rear;}
void bfs(int start){
	visited[start]=1;
	enqueue(start);
	while(!isEmpty()){
		int current=dequeue();
		printf("%d ",current);
		for(int i=0;i&lt;adjCount[current];i++){
			int neighbor=adj[current][i];
			if(!visited[neighbor]){
				visited[neighbor]=1;
				enqueue(neighbor);}}}}
int main(){
	int vertices,edges;
	scanf("%d %d",&amp;vertices,&amp;edges);
	for(int i=0;i&lt;edges;i++){
		adjCount[i]=0;
		visited[i]=0;}
	for(int i=0;i&lt;edges;i++){
		int u,v;
		scanf("%d %d",&amp;u,&amp;v);
		adj[u][adjCount[u]++]=v;}
	for(int i=0;i&lt; vertices;i++){
		qsort(adj[i],adjCount[i],sizeof(int),compare);}
