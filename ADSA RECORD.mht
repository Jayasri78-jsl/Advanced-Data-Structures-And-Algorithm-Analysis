nter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="a14fac8d-41de-4c9c-87c2-e8c46f09c44f"></p><p data-ref="4234d43b-90ed-412c-b282-abe6c9ff794d" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="955d1167-43aa-4d42-b4ef-cf8f7edc57d5"></p><p data-ref="f914df67-4b3f-473c-881b-8c5889f3634f" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="18ebc7b6-8219-4e1b-b63d-9d73dfb23441">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="24868ef5-46a2-4826-b488-9b3c49307178"><div class="ml-1 mb-3" data-ref="d57bdfb6-e250-4d77-a7f7-a001da97632f"><b style="border-bottom:1px solid black;" data-ref="82da052c-2e8e-48f6-ac58-d962079393cc" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="c0e0f9bb-432b-4b08-b9ed-b97bc15b709b" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="af6cfe9e-01c7-4339-8440-b6a9cce9da53" data-undisplayed="undisplayed">Btreemain.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="d4b38773-e9d4-4dfa-9a59-ccd9a6f99231" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;stdbool.h&gt;
typedef struct BTreeNode {
	int *keys;int t,n;
	struct BTreeNode **C;
	bool leaf;
} BTreeNode;
BTreeNode* createNode(int t, bool leaf) {
	BTreeNode* node = (BTreeNode*)malloc(sizeof(BTreeNode));
	node-&gt;t = t;
	node-&gt;leaf = leaf;
	node-&gt;keys = (int*)malloc((2 * t - 1) * sizeof(int));
	node-&gt;C = (BTreeNode**)malloc((2 * t) * sizeof(BTreeNode*));
	node-&gt;n = 0;
	return node;
}
void inorder(BTreeNode* root) {
	if (!root) return;
	for (int i = 0; i &lt; root-&gt;n; i++) {
	if (!root-&gt;leaf)
		inorder(root-&gt;C[i]);
		printf("%d ", root-&gt;keys[i]);}
	if (!root-&gt;leaf)
		inorder(root-&gt;C[root-&gt;n]);}
bool search(BTreeNode* root, int k) {
	int i = 0;
	while (i &lt; root-&gt;n &amp;&amp; k &gt; root-&gt;keys[i])
		i++;
	if (i &lt; root-&gt;n &amp;&amp; root-&gt;keys[i] == k)
		return true;
	if (root-&gt;leaf)
		return false;
	return search(root-&gt;C[i], k);}
void splitChild(BTreeNode* x, int i) {
	int t = x-&gt;t;
	BTreeNode* y = x-&gt;C[i];
	BTreeNode* z = createNode(t, y-&gt;leaf);
	z-&gt;n = t - 1;
	for (int j = 0; j &lt; t - 1; j++)
		z-&gt;keys[j] = y-&gt;keys[j + t];
	if (!y-&gt;leaf) {
		for (int j = 0; j &lt; t; j++)
			z-&gt;C[j] = y-&gt;C[j + t];
	}
	y-&gt;n = t - 1;
	for (int j = x-&gt;n; j &gt;= i + 1; j--)
		x-&gt;C[j + 1] = x-&gt;C[j];
	x-&gt;C[i + 1] = z;
	for (int j = x-&gt;n - 1; j &gt;= i; j--)
		x-&gt;keys[j + 1] = x-&gt;keys[j];
	x-&gt;keys[i] = y-&gt;keys[t - 1];
	x-&gt;n++;}
void insertNonFull(BTreeNode* x, int k) {
	int i = x-&gt;n - 1;
	if (x-&gt;leaf) {
		while (i &gt;= 0 &amp;&amp; k &lt; x-&gt;keys[i]) {
			x-&gt;keys[i + 1] = x-&gt;keys[i];
				i--;}
		x-&gt;keys[i + 1] = k;
		x-&gt;n++;
	} else {
		while (i &gt;= 0 &amp;&amp; k &lt; x-&gt;keys[i])
			i--;i++;
			if (x-&gt;C[i]-&gt;n == 2 * x-&gt;t - 1) {
				splitChild(x, i);
			if (k &gt; x-&gt;keys[i])
				i++;
		}insertNonFull(x-&gt;C[i], k);}}
void insert(BTreeNode** rootRef, int k) {
	BTreeNode* r = *rootRef;
	if (r-&gt;n == 2 * r-&gt;t - 1) {
		BTreeNode* s = createNode(r-&gt;t, false);
		s-&gt;C[0] = r;
		splitChild(s, 0);
		int i = (k &gt; s-&gt;keys[0]) ? 1 : 0;
		insertNonFull(s-&gt;C[i], k);
		*rootRef = s;
	} else {insertNonFull(r, k);}}
int getPred(BTreeNode* x) {
	while (!x-&gt;leaf)
		x = x-&gt;C[x-&gt;n];
	return x-&gt;keys[x-&gt;n - 1];}
int getSucc(BTreeNode* x) {
	while (!x-&gt;leaf)
		x = x-&gt;C[0];
	return x-&gt;keys[0];}
void merge(BTreeNode* x, int idx) {
	BTreeNode* c1 = x-&gt;C[idx];
	BTreeNode* c2 = x-&gt;C[idx + 1];
	int t = x-&gt;t;
	c1-&gt;keys[t - 1] = x-&gt;keys[idx];
	for (int i = 0; i &lt; c2-&gt;n; ++i)
		c1-&gt;keys[i + t] = c2-&gt;keys[i];
	if (!c1-&gt;leaf) {
		for (int i = 0; i &lt;= c2-&gt;n; ++i)
			c1-&gt;C[i + t] = c2-&gt;C[i];}
	for (int i = idx + 1; i &lt; x-&gt;n; ++i)
		x-&gt;keys[i - 1] = x-&gt;keys[i];
	for (int i = idx + 2; i &lt;= x-&gt;n; ++i)
		x-&gt;C[i - 1] = x-&gt;C[i];
	c1-&gt;n += c2-&gt;n + 1;
	x-&gt;n--;
	free(c2);}
void fill(BTreeNode* x, int idx) {
	int t = x-&gt;t;
	if (idx &gt; 0 &amp;&amp; x-&gt;C[idx - 1]-&gt;n &gt;= t) {
		BTreeNode* child = x-&gt;C[idx];
		BTreeNode* sibling = x-&gt;C[idx - 1];
		for (int i = child-&gt;n - 1; i &gt;= 0; --i)
			child-&gt;keys[i + 1] = child-&gt;keys[i];
		if (!child-&gt;leaf) {
			for (int i = child-&gt;n; i &gt;= 0; --i)
				child-&gt;C[i + 1] = child-&gt;C[i];}
			child-&gt;keys[0] = x-&gt;keys[idx - 1];
		if (!child-&gt;leaf)
			child-&gt;C[0] = sibling-&gt;C[sibling-&gt;n];
		x-&gt;keys[idx - 1] = sibling-&gt;keys[sibling-&gt;n - 1];
		child-&gt;n += 1;sibling-&gt;n -= 1;
	} else if (idx &lt; x-&gt;n &amp;&amp; x-&gt;C[idx + 1]-&gt;n &gt;= t) {
		BTreeNode* child = x-&gt;C[idx];
		BTreeNode* sibling = x-&gt;C[idx + 1];
		child-&gt;keys[child-&gt;n] = x-&gt;keys[idx];
		if (!child-&gt;leaf)
			child-&gt;C[child-&gt;n + 1] = sibling-&gt;C[0];
		x-&gt;keys[idx] = sibling-&gt;keys[0];
		for (int i = 1; i &lt; sibling-&gt;n; ++i)
			sibling-&gt;keys[i - 1] = sibling-&gt;keys[i];
		if (!sibling-&gt;leaf) {
			for (int i = 1; i &lt;= sibling-&gt;n; ++i)
				sibling-&gt;C[i - 1] = sibling-&gt;C[i];}
		child-&gt;n += 1;
		sibling-&gt;n -= 1;
	} else {
		if (idx != x-&gt;n)
			merge(x, idx);
		else
			merge(x, idx - 1);}}
void removeFromNode(BTreeNode* x, int k) {
	int idx = 0;
	while (idx &lt; x-&gt;n &amp;&amp; x-&gt;keys[idx] &lt; k)
		++idx;
	if (idx &lt; x-&gt;n &amp;&amp; x-&gt;keys[idx] == k) {
		if (x-&gt;leaf) {
			for (int i = idx + 1; i &lt; x-&gt;n; ++i)
				x-&gt;keys[i - 1] = x-&gt;keys[i];
			x-&gt;n--;} else {
			if (x-&gt;C[idx]-&gt;n &gt;= x-&gt;t) {
				int pred = getPred(x-&gt;C[idx]);
				x-&gt;keys[idx] = pred;
				removeFromNode(x-&gt;C[idx], pred);
			} else if (x-&gt;C[idx + 1]-&gt;n &gt;= x-&gt;t) {
				int succ = getSucc(x-&gt;C[idx + 1]);x-&gt;keys[idx] = succ;
				removeFromNode(x-&gt;C[idx + 1], succ);
			} else {
				merge(x, idx);
