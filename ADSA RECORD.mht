struct Job{
	int id,deadline,profit;};
int compare(const void* a,const void *b){
	struct Job*j1=(struct Job*)a;struct Job*j2=(struct Job*)b;
	return j2-&gt;profit-j1-&gt;profit;}
int main(){
	int n;scanf("%d",&amp;n);
	struct Job jobs[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d %d %d",&amp;jobs[i].id,&amp;jobs[i].deadline,&amp;jobs[i].profit);}
	qsort(jobs,n,sizeof(struct Job),compare);int maxDeadline=0;
	for(int i=0;i&lt;n;i++){if(jobs[i].deadline&gt;maxDeadline)
			maxDeadline=jobs[i].deadline;}
		int filled[maxDeadline+1];
		for(int i=0;i&lt;=maxDeadline;i++){filled[i]=0;}
		int total=0,count=0;
		for(int i=0;i&lt;n;i++){
			for(int j=jobs[i].deadline;j&gt;=1;j--){if(filled[j]==0){
					filled[j]=1;total+=jobs[i].profit;count++;
					break;}}}
	printf("%d ",count);printf("%d\n",total);return 0;}</pre><br data-ref="f03a3d15-1d4c-4873-8d22-12bf6f4464c8"></div></div><div class="row" data-ref="4ab4e6ef-0540-4859-88b4-80895a6e9e77"><div class="col-12" data-ref="89626282-a71e-4709-8561-3f62c40491ad"><h5 class="execResultsHeading text-center" data-ref="57548e05-d79f-4aec-a84c-a1db9a394fc3">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="a4c09784-af91-4ecc-bcfb-df76f7676e4a" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="043eeed3-fbb8-496e-8ac5-aa56a8927b43"><div class="row execution-results-border" data-ref="232f94cc-9097-4b67-95ab-7e97f5c76116"><div class="col-12 p-2 text-center font-weight-bold" data-ref="b8975211-939c-4ca7-9e53-a951f2f189d6">Test Case - 1</div></div><div class="row execution-results-border" data-ref="6108a766-5a6c-4759-9a51-c98f42b1cd12"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="61dd6700-3624-47f8-a059-0829e5cabfc4">User Output</div></div><div class="row execution-results-border" data-ref="c2470697-2a97-41c6-a2e0-745dd2feb0c2"><div class="col-6" data-ref="2c783cc3-91b4-4388-90eb-68d7f54fa143"><span class="cmd" title="User Input" data-ref="4bf110d8-c1a2-4f32-a8ae-39f0f8146383">4</span></div></div><div class="row execution-results-border" data-ref="c2d381fe-863f-4231-b6b4-5cb6cc7f7929"><div class="col-6" data-ref="2aecb1c3-3d02-498d-bc5d-2f3b0aaacc61"><span class="cmd" title="User Input" data-ref="cb20b99e-20dd-4482-991f-dc4c0f41506c">1 4 20</span></div></div><div class="row execution-results-border" data-ref="293a90e2-9f8c-4e33-a12b-78585c01344c"><div class="col-6" data-ref="6b35b30e-5e69-476b-b6d8-38b2c5c10e55"><span class="cmd" title="User Input" data-ref="a4510055-a3b2-4560-903b-f1b4f9520dee">2 1 10</span></div></div><div class="row execution-results-border" data-ref="0f9e44c8-7de0-4ca2-b5f6-7b1c01c24e78"><div class="col-6" data-ref="20ccd8b6-ed4f-45f1-a86b-9