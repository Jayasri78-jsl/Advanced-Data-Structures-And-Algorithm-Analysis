int n,values[100],weights[100],capacity,maxProfit=0;
void knapsack(int i,int curweight,int curvalue){
	if(i==n){if(curvalue&gt;maxProfit)
			maxProfit=curvalue;return;}
	knapsack(i+1,curweight,curvalue);
	if(curweight+weights[i]&lt;=capacity){
		knapsack(i+1,curweight+weights[i],curvalue+values[i]);}}
int main(){scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++){scanf("%d %d",&amp;values[i],&amp;weights[i]);}
	scanf("%d",&amp;capacity);knapsack(0,0,0);
	printf("%d\n",maxProfit);return 0;}

