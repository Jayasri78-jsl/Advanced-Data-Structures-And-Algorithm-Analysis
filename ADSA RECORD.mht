void merge(int a[],int low,int mid,int high){
	int i,j,k,temp[100];
	i=low;k=low;j=mid+1;
	while(i&lt;=mid &amp;&amp; j&lt;=high){
		if(a[i]&lt;=a[j]){temp[k]=a[i];i++;}
		else{temp[k]=a[j];j++;}k++;}
	if(i&gt;mid){
		while(j&lt;=high){
			temp[k]=a[j];j++;k++;}}
	else{while(i&lt;=mid){
			temp[k]=a[i];i++;k++;}}
	for(k=0;k&lt;=high;k++){
		a[k]=temp[k];}}
void mergesort(int a[],int low,int high){
	if(low&lt;high){
		int mid=(low+high)/2;
		mergesort(a,low,mid);
		mergesort(a,mid+1,high);
		merge(a,low,mid,high);}}
int main(){
