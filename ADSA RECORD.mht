		int totalCost=currCost+cost[city][start];
		if(totalCost&lt;minCost)minCost=totalCost;
		return;}
	for(int next=0;next&lt;n;next++){
		if(!visited[next]&amp;&amp;cost[city][next]!=INF){
			visited[next]=1;
			tsp(next,count+1,currCost+cost[city][next],start);
				visited[next]=0;}}}
int main(){
