r class="MathJax" jax="CHTML" style="font-size: 117.2%; position: relative;" data-ref="a553bdce-4784-45a0-9967-f9c4f7149cad" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="ac66a5ed-8853-4a5f-9c1b-56a8f2684d26"><mjx-mi class="mjx-i" data-ref="a20f6ee9-8852-44c4-8a0c-46816f3058ff"><mjx-c class="mjx-c1D458 TEX-I" data-ref="086863af-fd2d-4184-8ef5-c2ba6c683ef7"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="ff1731ce-e43e-43dd-bf81-04233207ae37"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="0f86679b-a221-40d9-9320-2e2156e65e24"><mi data-ref="3c26137a-82a2-4d11-8ca4-df0641ebf7b9">k</mi></math></mjx-assistive-mml></mjx-container> deletions of the root element.</li></ul><p data-ref="89cfb9d1-d41d-4cae-bf50-2b789c8af260" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="4f8f52a5-8225-4141-92d5-500ff0c2abf6"></p><p data-ref="f1097512-6653-49cc-91b8-3d6068f4a7df" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="1c8ff549-c4a1-4c16-8a33-338a583b9f42">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="1401794b-a139-440c-9c8a-bad8f95e9fcc"><div class="ml-1 mb-3" data-ref="ee56ada7-7de9-4e50-9eb1-d84ffa7b22ad"><b style="border-bottom:1px solid black;" data-ref="3731eae8-d00d-47b5-bfe2-9b6b18876345" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="9acc50f1-0fcb-4466-b6b3-b123a4c8ae5d" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="06a04ac6-858a-4e42-b957-1c2d88191a2a" data-undisplayed="undisplayed">maxheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="9aad2c21-4082-4b02-b121-dee0eb426936" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#define max 20
int a[max];
int size=0;
void swap(int *a,int *b){
	int temp=*a;
	*a=*b;
	*b=temp;}
void heapify(int index){
	int temp;
	while(index&gt;0){
		int parent=(index-1)/2;
		if(a[parent]&lt;=a[index]){
			temp=a[parent];
			a[parent]=a[index];
			a[index]=temp;
			index=parent;}else{break;}}}
void insert(int k){
	a[size]=k;
	heapify(size);
	size++;}
void heapifydown(int index){
	int i,smallest;
	while(1){
		int left=2*index+1;
		int right=2*index+2;
		smallest=index;
		if(left&lt;size &amp;&amp; a[smallest]&lt;a[left]){
			smallest=left;}
		if(right&lt;size &amp;&amp; a[smallest]&lt;a[right]){
			smallest=right;}
			if(smallest!=index){
				swap(&amp;a[smallest],&amp;a[index]);
				index=smallest;}
			else{break;}}}
void deletefunction(){
	if(size==0){
		return;}
	a[0]=a[size-1];
	size--;
	heapifydown(0);}
int main(){
	int n,k,i;
	scanf("%d",&amp;n);
	for(i=0;i&lt;n;i++){
		scanf("%d",&amp;k);insert(k);}int s;scanf("%d",&amp;s);
	for(i=0;i&lt;n;i++){
		printf("%d ",a[i]);}printf("\n");
	for(i=1;i&lt;=s;i++){
		deletefunction();}
	for(i=0;i&lt;size;i++){
		printf("%d ",a[i]);}printf("\n");}</pre><br data-ref="a8455450-57ed-41b4-8c22-34f76760b995"></div></div><div class="row" data-ref="fb4d7eba-a729-4c7f-94e1-297280b48bdf"><div class="col-12" data-ref="e0beae3b-4840-455b-9cc6-4183425406c1"><h5 class="execResultsHeading text-center" data-ref="1333609e-8e34-42fa-bcbd-8ad8426d0ece">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="62962bcb-728c-44fb-a77e-0aaaf3670bdc" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="908df8fa-eede-4ae9-81b3-ded38ca12aba"><div class="row execution-results-border" data-ref="d8941418-2b2b-4237-8886-ca2affc575a3"><div class="col-12 p-2 text-center font-weight-bold" data-ref="ef84a217-dff8-48a3-b1a8-f42b04118695">Test Case - 1</div></div><div class="row execution-results-border" data-ref="e41f9322-1c5f-44a4-8e90-9a03877a2a46"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="0e4ded11-bd13-401c-b754-0af2188d13fd">User Output</div></div><div class="row execution-results-border" data-ref="ed867c57-e31e-4a1c-a6ca-91293f7343f8"><div class="col-6" data-ref="b2ef993a-f6c3-4553-a660-f74c340f3f7c"><span class="cmd" title="User Input" data-ref="34c7c976-f482-43c7-bfa8-329e9de7e63a">6</span></div></div><div class="row execution-results-border" data-ref="64c3556d-8895-48cf-980c-6cffd63c887c"><div class="col-6" data-ref="b955e099-b85a-4ef9-b4c8-b2ddbb62a4c5"><span class="cmd" title="User Input" data-ref="b8339ff9-f278-475f-8fc4-11a0b0ab8433">30 10 20 40 50 5</span></div></div><div class="row execution-results-border" data-ref="a996e070-9f29-430d-8dd3-43b434c5a959"><div class="col-6" data-ref="dba47502-fe2a-4da7-ad63-01de62fa87f4"><span class="cmd" title="User Input" data-ref="ce69f6b7-2e4a-4d80-beeb-3e0b9153db12">2</span></div></div><div class="row execution-results-border" data-ref="7aee2c88-9886-4eb1-a374-15a56215dab3"><div class="col-12" data-ref="2b0c5216-813d-4eb3-b20d-bae1cbec2fb