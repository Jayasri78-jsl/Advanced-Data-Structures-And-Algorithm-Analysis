#include&lt;stdlib.h&gt;
#define MAX 100
int  adj[MAX][MAX];
int visited[MAX];
int adjCount[MAX];
int compare(const void*a,const void*b){
	return(*(int*)a-*(int*)b);}
void dfs(int vertex){
	visited[vertex]=1;
	printf("%d ",vertex);
	for(int i=0;i&lt;adjCount[vertex];i++){
		int neighbor=adj[vertex][i];
		if(!visited[neighbor]){
			dfs(neighbor);}}}
int main(){
	int vertices,edges;
	scanf("%d %d",&amp;vertices,&amp;edges);
	for(int i=0;i&lt;vertices;i++){
		adjCount[i]=0;
		visited[i]=0;}
	for(int i=0;i&lt;edges;i++){
		int u,v;
		scanf("%d %d",&amp;u,&amp;v);
		adj[u][adjCount[u]++]=v;}
