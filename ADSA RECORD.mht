			scanf("%d",&amp;val);
			if(val==-1){
				cost[i][j]=INF;}
			else{cost[i][j]=val;
				}}}
	for(int i=0;i&lt;n;i++)
		visited[i]=0;
	visited[0]=1;
	tsp(0,1,0,0);
