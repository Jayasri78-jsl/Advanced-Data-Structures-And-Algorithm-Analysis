#include&lt;stdlib.h&gt;
#define MAX 100
int V,E,adj[MAX][MAX],disc[MAX],low[MAX],parent[MAX];
int time_dfs,bccCount;
struct Edge {int u,v;} stackEdges[MAX*MAX];
int top=-1;
void pushEdge(int u,int v){
	stackEdges[++top]=(struct Edge){u,v};}
void popUntil(int u,int v){
	while(top&gt;=0){
		struct Edge e=stackEdges[top--];
		if((e.u==u &amp;&amp; e.v==v)||(e.u==v &amp;&amp; e.v==u)) break;}}
void BCCUtil(int u){int children=0;
	disc[u]=low[u]=++time_dfs;
	for(int v=0;v&lt;V;v++){if(adj[u][v]){
			if(disc[v]==-1){children++;
				parent[v]=u;pushEdge(u,v);BCCUtil(v);
				if(low[v]&gt;=disc[u]){bccCount++;popUntil(u,v);}
				if(low[v]&lt;low[u]) low[u]=low[v];}
			else if(v!=parent[u] &amp;&amp; disc[v]&lt;disc[u]){pushEdge(u,v);
				if(disc[v]&lt;low[u]) low[u]=disc[v];}}}}
void findBCCs(){
	for(int i=0;i&lt;V;i++){disc[i]=-1;parent[i]=-1;}
	time_dfs=0;bccCount=0;top=-1;
	for(int i=0;i&lt;V;i++){if(disc[i]==-1){BCCUtil(i);if(top&gt;=0){
				bccCount++;top=-1;}}}}
int main(){
	scanf("%d %d",&amp;V,&amp;E);
	for(int i=0;i&lt;V;i++)
		for(int j=0;j&lt;V;j++)
			adj[i][j]=0;
	for(int i=0;i&lt;E;i++){
		int u,v;scanf("%d %d",&amp;u,&amp;v);
		adj[u][v]=adj[v][u]=1;}
	findBCCs();printf("%d\n",bccCount);return 0;}

