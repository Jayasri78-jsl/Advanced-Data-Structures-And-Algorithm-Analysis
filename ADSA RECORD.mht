int knapsack(int weights[],int profits[],int n,int m){int M[n+1][m+1];
	for(int i=0;i&lt;=n;i++){
		for(int j=0;j&lt;=m;j++){if(i==0 || j==0) M[i][j]=0;
			else if(weights[i-1]&lt;=j)
				M[i][j]=(profits[i-1]+M[i-1][j-weights[i-1]]&gt;M[i-1][j])?(profits[i-1]+M[i-1][j-weights[i-1]]):M[i-1][j];
			else M[i][j]=M[i-1][j];}}return M[n][m];}
int main(){
	int n;scanf("%d",&amp;n);
	int weights[n],profits[n];
	for(int i=0;i&lt;n;i++){scanf("%d",&amp;weights[i]);}
	for(int i=0;i&lt;n;i++){scanf("%d",&amp;profits[i]);}
	int capacity;scanf("%d",&amp;capacity);
	int maxProfit=knapsack(weights,profits,n,capacity);
	printf("%d\n",maxProfit);return 0;}</pre><br data-ref="394ea80a-8e22-4eaf-8981-82e280316920"></div></div><div class="row" data-ref="361b3568-7129-4e12-a358-e2316ce33612"><div class="col-12" data-ref="2f343144-861a-4496-94f1-0b4dbe86f95b"><h5 class="execResultsHeading text-center" data-ref="2dac3dc5-5791-4738-9e0e-52f5a80e11eb">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="5d74e2a3-9064-4912-baec-232ff796717f" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="b27852b7-60b2-4e57-9fc5-30085cd38acb"><div class="row execution-results-border" data-ref="1708577b-20ac-4d50-a46f-4452f12e58ef"><div class="col-12 p-2 text-center font-weight-bold" data-ref="9b944627-88f7-41b2-9a6b-7fdb75102356">Test Case - 1</div></div><div class="row execution-results-border" data-ref="b6b6296c-d7d9-4e47-a967-3808c81376e2"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="f930d9e9-4395-44ab-93c6-1976810efba7">User Output</div></div><div class="row execution-results-border" data-ref="05f7bb30-b883-42f9-8a36-e1d2ec38e0f9"><div class="col-6" data-ref="0c766fae-b825-49b8-b190-38a749ee9c0f"><span class="cmd" title="User Input" data-ref="82e71d4e-e2e0-4f72-8a26-e45ec081171f">5</span></div></div><div class="row execution-results-border" data-ref="55e31e68-b1ac-44cf-8055-2e96c7f87271"><div class="col-6" data-ref="01e70504-858a-45da-b6a6-bf84d309bf33"><span class="cmd" title="User Input" data-ref="ac06f243-9f8b-45eb-b564-ab5889124aea">5 10 15 20 25</span></div></div><div class="row execution-results-border" data-ref="d16ad78c-4de9-4935-a47e-f7300d1c8261"><div class="col-6" data-ref="8ef1d546-118f-4e08-b9d8-4a51176e46af"><span class="cmd" title="User Input" data-ref="7e65de07-03fd-4e92-b6eb-0b69aa127ca9">10 20 30 40 50</span></div></div><div class="row execution-results-border" data-ref="3cd37efe-9387-4fa1-9ac0-4841d01c443e"><div class="col-6" data-ref="9384a6e9-635f-45c3-9747-05