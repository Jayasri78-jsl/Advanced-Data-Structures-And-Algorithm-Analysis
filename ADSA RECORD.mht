-cD7" data-ref="e3e30bf3-2b44-4a7d-90af-d4be5bc9d8e9"></mjx-c></mjx-mo><mjx-mi class="mjx-i" space="3" data-ref="c44d3698-a03f-4d34-a57c-8486fa45e7ab"><mjx-c class="mjx-c1D441 TEX-I" data-ref="4b64b335-6a41-4387-8a83-a7b9e7e93d7c"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="e220ef66-c44d-4cb4-9b74-924ebaaf888a"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="b3f2127b-408c-4fd7-991f-51534ddf7f8b"><mi data-ref="ccfccf83-4915-4bf5-9956-eb79363f1474">N</mi><mo data-ref="cf1c674a-d07d-4407-b32b-9db242983eda">Ã—</mo><mi data-ref="268e6bcf-755a-43b6-af6b-cab10eb00826">N</mi></math></mjx-assistive-mml></mjx-container> chessboard such that no two queens attack each other. A queen can attack another queen if they share the same row, column, or diagonal. Your program should print the first valid configuration of the board found by placing queens from left to right and top to bottom, using a backtracking approach. The board must be displayed as an <mjx-container class="MathJax" jax="CHTML" style="font-size: 117.2%; position: relative;" data-ref="b8f6bf80-54d6-4d40-9758-12972b2c7ef2" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="8278103d-b5fd-4115-a3a7-f3a451c5acfd"><mjx-mi class="mjx-i" data-ref="ede46b96-a817-4ee8-ae66-546453956fa7"><mjx-c class="mjx-c1D441 TEX-I" data-ref="5ad81513-523b-4828-8c00-429b5217dd26"></mjx-c></mjx-mi><mjx-mo class="mjx-n" space="3" data-ref="2458c123-e99d-47f2-897b-6aeafad154ed"><mjx-c class="mjx-cD7" data-ref="89d2688a-4c96-4573-ba08-07b51dbe4b19"></mjx-c></mjx-mo><mjx-mi class="mjx-i" space="3" data-ref="7f2d3e50-a5eb-4b6e-b1e5-68d819364e95"><mjx-c class="mjx-c1D441 TEX-I" data-ref="66a9f91c-b5fd-4a3d-a046-0b66315b2006"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="c0631107-06dc-485b-99f2-65a5a1b7b24b"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="8dc0f5fa-f633-482d-a261-49bfbc68adfc"><mi data-ref="b6956493-db80-4610-8a3b-9c53f5b81e63">N</mi><mo data-ref="b8e349de-6041-4d8a-8b13-5ae35c321b00">Ã—</mo><mi data-ref="683bb8b1-7699-4e63-a80a-732eba4b372a">N</mi></math></mjx-assistive-mml></mjx-container> matrix where a cell contains 1 if a queen is placed there, and 0 otherwise. If no solution exists for the given value of <mjx-container class="MathJax" jax="CHTML" style="font-size: 117.2%; position: relative;" data-ref="a1614b67-33ee-4250-bfe5-b9ceaff86a3a" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="758a05b8-c7c8-45e5-8b4b-6bd88401303b"><mjx-mi class="mjx-i" data-ref="02025500-4a51-4b51-8f89-4cdb6209c14b"><mjx-c class="mjx-c1D441 TEX-I" data-ref="68b831e4-ee85-4aa1-b92f-8de1f40f0383"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="d5b5a677-49e3-46a0-84ee-a0a36d587b9b"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="8ec1fbcd-a58f-4ce3-8fc4-13c39087626f"><mi data-ref="0ac4611a-2988-4ec6-82f2-01603fe7eb5f">N</mi></math></mjx-assistive-mml></mjx-container>, print a message indicating that no solution exists.</p><p data-ref="f21063dc-1aa6-45f8-b03a-1354c14d5f6b" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="3602ce79-8b58-41f2-8079-8f4d8e9cffd7"></p><p data-ref="ae94f844-12b5-4e1d-89c9-74b747990830" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="73c79242-792e-434f-8611-0a21f29e62aa">Input Format:</strong></p><ul data-ref="35503124-859f-41e8-bfa7-9ea90c421976" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="c4e51bf7-816c-4c69-ba54-742c80a2cf0a">A single integer <mjx-container class="MathJax" jax="CHTML" style="font-size: 117.2%; position: relative;" data-ref="4e348212-7ce4-4568-86a9-aab0686b53bc" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="3d7ba720-14ad-4110-b2ab-e969b62af5e0"><mjx-mi class="mjx-i" data-ref="8478097d-c1ed-4b0e-9091-5dc01d47d888"><mjx-c class="mjx-c1D441 TEX-I" data-ref="3c4969db-e034-45d7-8741-caa05f877ec1"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="c2a05ab9-9fcf-4cff-a3c6-07166cac8f4f"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="3b0d4d4e-c157-474a-abbb-03bcdd01d2c5"><mi data-ref="96ec6eef-7cd8-4495-b50b-004d5b824d2c">N</mi></math></mjx-assistive-mml></mjx-container> â€” the number of queens and the size of the chessboard.</li></ul><p data-ref="06f5d67e-ece5-4111-b317-af762bc2e664" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="a254a895-3420-4366-b014-3d8a485e4a87"></p><p data-ref="417e9d65-cfaf-4df1-9f09-05c55dcf81d8" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-l