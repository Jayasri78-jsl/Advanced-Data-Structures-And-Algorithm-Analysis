ist-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="817bbbe6-b25b-478c-a6f8-67c1529b400a"></p><p data-ref="9767e786-17c8-4108-9f91-f6cafd6c8be6" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="1c257de4-88c1-49a1-acac-58433f3f82a2">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="c00ae16a-ded9-45f6-841c-5dfe40cd4f1a"><div class="ml-1 mb-3" data-ref="4a12481d-8058-42bb-bda2-cc74303e351b"><b style="border-bottom:1px solid black;" data-ref="9bd95815-e726-411b-9b1a-083cfefbcd94" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="8ac3e727-2a08-4cce-ac49-9284baad3172" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="8d9646de-41c7-4cfd-a257-cebfb224b55d" data-undisplayed="undisplayed">nqueens.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="036bfdf7-550f-4de7-8fab-404ef885a54b" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdbool.h&gt;
#define MAX 20
int board[MAX][MAX],N;
void printBoard(){
	for(int i=0;i&lt;N;i++){
		for(int j=0;j&lt;N;j++) 
			printf("%d ",board[i][j]);
		printf("\n");}}
	bool isSafe(int row,int col){
		for(int i=0;i&lt;row;i++) 
			if(board[i][col]) 
				return false;
		for(int i=row,j=col;i&gt;=0 &amp;&amp; j&gt;=0;i--,j--)
			if(board[i][j]) 
				return false;
		for(int i=row,j=col;i&gt;=0 &amp;&amp; j&lt;N;i--,j++)
			if(board[i][j]) 
				return false;
		return true;}
	bool solveNQueens(int row){
		if(row&gt;=N) 
			return true;
		for(int col=0;col&lt;N;col++){
			if(isSafe(row,col)){
				board[row][col]=1;
				if(solveNQueens(row+1))
					return true;
				board[row][col]=0;}}
		return false;}
	int main(){
		scanf("%d",&amp;N);
		if(solveNQueens(0))
			printBoard();
		else printf("No solution exists for N = %d\n",N);
